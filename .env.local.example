# Copy to `.env.local` and fill in. `.env.local` is gitignored — keep it that
# way, GOOGLE_SHEETS_TOKEN is a secret.
#
# Both values come from GOOGLE_SHEET_SETUP.md. With them unset the site works
# exactly as before: RSVPs are saved to .data/rsvps.json and nothing is sent
# anywhere.

GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx4j8O8s8tWlEC-9FhvVmfv4Teeq7s54djxL2COza_5Sjfgzk-mafec8UUVI0CvvSqa8w/exec
GOOGLE_SHEETS_TOKEN=change-me-to-something-random
